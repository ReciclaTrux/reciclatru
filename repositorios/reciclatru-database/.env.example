# Copia este archivo a .env (está en .gitignore) y completa los valores.
# Neon: usa la cadena de conexión DIRECTA (sin "-pooler") para las migraciones.
# Flyway usa bloqueos de sesión que el pooler (PgBouncer) puede romper.

# Local (docker compose)
FLYWAY_URL=jdbc:postgresql://localhost:5432/reciclatru
FLYWAY_USER=reciclatru
FLYWAY_PASSWORD=reciclatru

# Neon (ejemplo; reemplaza host, base y credenciales)
# FLYWAY_URL=jdbc:postgresql://ep-xxxx-xxxx.us-east-2.aws.neon.tech/reciclatru?sslmode=require
# FLYWAY_USER=neondb_owner
# FLYWAY_PASSWORD=********
